{
  "manifest_version": 3,
  "name": "Legasys Quick Access",
  "version": "1.0.0",
  "description": "Quick access to Legasys features",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.filevine.com/*",
    "https://*.vinesign.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "https://*.filevine.com/*"],
      "js": ["floating-widget.js"],
      "css": ["floating-widget.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.js", "popup.css", "floating-widget.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
